// Prisma schema for the ERP SaaS platform.
// Multi-tenancy model: single shared database, every business-data table
// carries a companyId and all app queries must filter by it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform / tenancy ----------

// Mirrors a Clerk user. Kept lightweight (synced on signup via webhook)
// so we can join against it without calling the Clerk API on every request.
model User {
  id              String   @id // Clerk user id
  email           String   @unique
  name            String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  companyUsers CompanyUser[]
  sales        Sale[]
  purchaseOrders PurchaseOrder[]
}

enum Module {
  INVENTORY
  SALES
  PURCHASING
  ACCOUNTING
}

model Company {
  id                 String    @id @default(cuid())
  name               String    @default("")
  currency           String    @default("USD")
  address            String?
  subscriptionStatus SubscriptionStatus @default(PENDING)
  enabledModules     Module[]  @default([])
  // Null until the Company Admin finishes the first-time setup wizard
  // (profile -> modules -> optional staff invite). Gates access to the
  // real app -- see requireCompanyContext() in src/lib/auth.ts.
  onboardingCompletedAt DateTime?
  createdAt          DateTime  @default(now())

  companyUsers      CompanyUser[]
  authorizedSignups AuthorizedSignup[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  sales             Sale[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  ledgerEntries     LedgerEntry[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CompanyRole {
  COMPANY_ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
}

model CompanyUser {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

// Allowlist gate for onboarding: created by a Platform Super Admin (companyId
// set, no company yet if it's a brand-new signup) or by a Company Admin adding
// their own staff. Consumed the moment a matching email completes Clerk signup.
model AuthorizedSignup {
  id         String      @id @default(cuid())
  email      String      @unique
  companyId  String
  role       CompanyRole
  invitedBy  String? // userId of whoever added this entry, null for platform-created
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ---------- Inventory ----------

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model Product {
  id                String   @id @default(cuid())
  companyId         String
  categoryId        String?
  sku               String
  name              String
  costPrice         Decimal  @db.Decimal(12, 2)
  sellPrice         Decimal  @db.Decimal(12, 2)
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
}

enum StockMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
}

// Every stock in/out, so levels are always auditable/reconstructable.
model StockMovement {
  id             String            @id @default(cuid())
  companyId      String
  productId      String
  type           StockMovementType
  quantityChange Int // positive = stock in, negative = stock out
  reason         String?
  referenceType  String? // "Sale" | "PurchaseOrder" | null for manual adjustment
  referenceId    String?
  createdAt      DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
}

// ---------- Sales / POS ----------

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@index([companyId])
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
}

model Sale {
  id            String        @id @default(cuid())
  companyId     String
  customerId    String?
  cashierId     String
  subtotal      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id])
  cashier  User       @relation(fields: [cashierId], references: [id])
  items    SaleItem[]

  @@index([companyId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

// ---------- Purchasing ----------

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  companyId  String
  supplierId String
  createdById String
  status     PurchaseOrderStatus @default(DRAFT)
  total      Decimal             @db.Decimal(12, 2)
  createdAt  DateTime            @default(now())
  receivedAt DateTime?

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([companyId, status])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ---------- Accounting ----------

enum LedgerEntryType {
  INCOME
  EXPENSE
}

// Auto-created from Sales (INCOME) and PurchaseOrders (EXPENSE) at the
// moment of completion/receipt, plus manual entries for things like rent.
// Fixed categories on purpose -- no configurable chart of accounts in v1.
model LedgerEntry {
  id            String          @id @default(cuid())
  companyId     String
  type          LedgerEntryType
  category      String
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  referenceType String? // "Sale" | "PurchaseOrder" | null for manual entry
  referenceId   String?
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
}
